<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_TeleMed" targetNamespace="http://telemedia.core/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:collaboration id="Collaboration_Core">
    <bpmn:participant id="Participant_Patient" name="Patient" processRef="Process_Patient" />
    <bpmn:participant id="Participant_Agent" name="intelligent-agent" processRef="Process_Agent" />
    <bpmn:participant id="Participant_Appointment" name="appointment-scheduling" processRef="Process_Appointment" />
    <bpmn:participant id="Participant_Professional" name="professional-management" processRef="Process_Professional" />
    <bpmn:participant id="Participant_Physician" name="Physician" processRef="Process_Physician" />
    <bpmn:participant id="Participant_Consultation" name="medical-consultation" processRef="Process_Consultation" />
    <bpmn:participant id="Participant_Document" name="document-generation" processRef="Process_Document" />
    <bpmn:participant id="Participant_Notification" name="notification-service" processRef="Process_Notification" />
    <bpmn:participant id="Participant_PatientService" name="patient-service" processRef="Process_PatientService" />
    <bpmn:messageFlow id="MF_Agent_Summary_Appt" name="PreConsultationSummaryGenerated" sourceRef="Send_PreConsultationSummaryGenerated" targetRef="Receive_PreConsultationSummaryGenerated" />
    <bpmn:messageFlow id="MF_Agent_Summary_Cons" name="PreConsultationSummaryGenerated" sourceRef="Send_PreConsultationSummaryGenerated" targetRef="Receive_PreConsultationSummary_Consultation" />
    <bpmn:messageFlow id="MF_Appt_CheckAvailability" name="CheckProfessionalAvailability" sourceRef="Send_CheckAvailability" targetRef="Receive_CheckAvailability" />
    <bpmn:messageFlow id="MF_Prof_AvailabilityResult" name="ProfessionalAvailabilityResult" sourceRef="Send_AvailabilityResult" targetRef="Receive_AvailabilityResult" />
    <bpmn:messageFlow id="MF_Appt_Created_Notification" name="AppointmentCreated" sourceRef="Send_AppointmentCreated" targetRef="Receive_AppointmentCreated_Notification" />
    <bpmn:messageFlow id="MF_Appt_Created_PatientService" name="AppointmentCreated" sourceRef="Send_AppointmentCreated" targetRef="Receive_AppointmentCreated_PatientService" />
    <bpmn:messageFlow id="MF_Consultation_Completed" name="ConsultationCompleted" sourceRef="Send_ConsultationCompleted" targetRef="Receive_ConsultationCompleted" />
    <bpmn:messageFlow id="MF_Consultation_PostSummary" name="PostConsultationSummaryGenerated" sourceRef="End_DocumentGenerated" targetRef="Send_PostConsultationSummaryGenerated" />
    <bpmn:messageFlow id="MF_Consultation_Referral_Notification" name="ReferralCreated" sourceRef="Send_ReferralCreated" targetRef="Receive_ReferralCreated_Notification" />
    <bpmn:messageFlow id="MF_Document_PdfGenerated_PatientService" name="ConsultationPdfGenerated" sourceRef="Send_ConsultationPdfGenerated" targetRef="Receive_ConsultationPdfGenerated_PatientService" />
  </bpmn:collaboration>
  <bpmn:message id="Message_PreconsultationStarted" name="PreconsultationStarted" />
  <bpmn:message id="Message_PreConsultationSummaryGenerated" name="PreConsultationSummaryGenerated" />
  <bpmn:message id="Message_CheckProfessionalAvailability" name="CheckProfessionalAvailability" />
  <bpmn:message id="Message_ProfessionalAvailabilityResult" name="ProfessionalAvailabilityResult" />
  <bpmn:message id="Message_AppointmentCreated" name="AppointmentCreated" />
  <bpmn:message id="Message_StartMedicalConsultation" name="StartMedicalConsultation" />
  <bpmn:message id="Message_ConsultationCompleted" name="ConsultationCompleted" />
  <bpmn:message id="Message_PostConsultationSummaryGenerated" name="PostConsultationSummaryGenerated" />
  <bpmn:message id="Message_ReferralCreated" name="ReferralCreated" />
  <bpmn:message id="Message_ConsultationPdfGenerated" name="ConsultationPdfGenerated" />
  <bpmn:message id="Message_AppointmentCancelled" name="AppointmentCancelled" />
  <bpmn:message id="Message_AppointmentRescheduled" name="AppointmentRescheduled" />
  <bpmn:message id="Message_AppointmentNoShow" name="AppointmentNoShow" />
  <bpmn:message id="Message_ManualRetryCommand" name="ManualRetryCommand" />
  <bpmn:error id="Error_PDFGeneration" name="PDFGenerationError" errorCode="PDF_GEN_ERROR" />
  <bpmn:process id="Process_Agent" name="intelligent-agent" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:endEvent id="End_Agent" name="Summary emitted">
      <bpmn:incoming>Flow_Agent_04</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Send_PreConsultationSummaryGenerated" name="Emit PreConsultationSummaryGenerated" camunda:type="external" camunda:topic="agent.emit-preconsultation-summary">
      <bpmn:incoming>Flow_Agent_03</bpmn:incoming>
      <bpmn:outgoing>Flow_Agent_04</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_GenerarSummary" name="Generate PreConsultationSummary" camunda:type="external" camunda:topic="agent.generate-summary">
      <bpmn:incoming>Flow_Agent_02</bpmn:incoming>
      <bpmn:outgoing>Flow_Agent_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ProcesarPreconsulta" name="Process preconsultation" camunda:type="external" camunda:topic="agent.process-preconsultation">
      <bpmn:incoming>Flow_Agent_01</bpmn:incoming>
      <bpmn:outgoing>Flow_Agent_02</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:startEvent id="Receive_PreconsultationStarted" name="Receive PreconsultationStarted">
      <bpmn:outgoing>Flow_Agent_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_PreconsultationStarted" messageRef="Message_PreconsultationStarted" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_Agent_04" sourceRef="Send_PreConsultationSummaryGenerated" targetRef="End_Agent" />
    <bpmn:sequenceFlow id="Flow_Agent_03" sourceRef="Task_GenerarSummary" targetRef="Send_PreConsultationSummaryGenerated" />
    <bpmn:sequenceFlow id="Flow_Agent_02" sourceRef="Task_ProcesarPreconsulta" targetRef="Task_GenerarSummary" />
    <bpmn:sequenceFlow id="Flow_Agent_01" sourceRef="Receive_PreconsultationStarted" targetRef="Task_ProcesarPreconsulta" />
  </bpmn:process>
  <bpmn:process id="Process_Appointment" name="appointment-scheduling" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:sendTask id="Send_CheckAvailability" name="Emit CheckProfessionalAvailability" camunda:type="external" camunda:topic="appt.check-availability">
      <bpmn:incoming>Flow_Appt_01</bpmn:incoming>
      <bpmn:incoming>Flow_Appt_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_02</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Receive_AvailabilityResult" name="Receive ProfessionalAvailabilityResult">
      <bpmn:incoming>Flow_Appt_02</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_03</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_AvailabilityResult" messageRef="Message_ProfessionalAvailabilityResult" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_SlotDisponible" name="Slot available?">
      <bpmn:incoming>Flow_Appt_03</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Appt_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CrearCita" name="Create appointment with summary" camunda:type="external" camunda:topic="appt.create">
      <bpmn:incoming>Flow_Appt_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_AppointmentCreated" name="Emit AppointmentCreated" camunda:type="external" camunda:topic="appt.emit-created">
      <bpmn:incoming>Flow_Appt_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_AppointmentCompleted" name="Appointment completed">
      <bpmn:incoming>Flow_Appt_08</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Send_AppointmentCompleted" name="Emit AppointmentCompleted" camunda:type="external" camunda:topic="appt.emit-completed">
      <bpmn:incoming>Flow_Appt_07</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_08</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_ActualizarStatus" name="Status = COMPLETED" camunda:type="external" camunda:topic="appt.update-status">
      <bpmn:incoming>Flow_Appt_06</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Receive_ConsultationCompleted" name="Receive ConsultationCompleted">
      <bpmn:incoming>Flow_Appt_Outcome_Completed</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_06</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_ConsultationCompleted" messageRef="Message_ConsultationCompleted" />
    </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="Gateway_AppointmentOutcome" name="What happens?">
      <bpmn:incoming>Flow_Appt_05</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_Outcome_Completed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Appt_Outcome_Cancelled</bpmn:outgoing>
      <bpmn:outgoing>Flow_Appt_Outcome_Rescheduled</bpmn:outgoing>
      <bpmn:outgoing>Flow_Appt_Outcome_NoShow</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="Receive_AppointmentCancelled" name="Receive AppointmentCancelled">
      <bpmn:incoming>Flow_Appt_Outcome_Cancelled</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_Cancelled</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_AppointmentCancelled" messageRef="Message_AppointmentCancelled" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_AppointmentCancelled" name="Appointment cancelled">
      <bpmn:incoming>Flow_Appt_Cancelled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Receive_AppointmentRescheduled" name="Receive AppointmentRescheduled">
      <bpmn:incoming>Flow_Appt_Outcome_Rescheduled</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_Rescheduled</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_AppointmentRescheduled" messageRef="Message_AppointmentRescheduled" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_AppointmentRescheduled" name="Appointment rescheduled">
      <bpmn:incoming>Flow_Appt_Rescheduled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Receive_AppointmentNoShow" name="Receive AppointmentNoShow">
      <bpmn:incoming>Flow_Appt_Outcome_NoShow</bpmn:incoming>
      <bpmn:outgoing>Flow_Appt_NoShow</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_AppointmentNoShow" messageRef="Message_AppointmentNoShow" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_AppointmentNoShow" name="Appointment no-show">
      <bpmn:incoming>Flow_Appt_NoShow</bpmn:incoming>
      <bpmn:incoming>Flow_Appt_NoShowTimeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_NoShowTimer" name="No-show (30 min from schedule)" attachedToRef="Receive_ConsultationCompleted">
      <bpmn:outgoing>Flow_Appt_NoShowTimeout</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Timer_NoShow">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_Appt_01" sourceRef="Receive_PreConsultationSummaryGenerated" targetRef="Send_CheckAvailability" />
    <bpmn:sequenceFlow id="Flow_Appt_No" name="No" sourceRef="Gateway_SlotDisponible" targetRef="Send_CheckAvailability">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!slotAvailable}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Appt_02" sourceRef="Send_CheckAvailability" targetRef="Receive_AvailabilityResult" />
    <bpmn:sequenceFlow id="Flow_Appt_03" sourceRef="Receive_AvailabilityResult" targetRef="Gateway_SlotDisponible" />
    <bpmn:sequenceFlow id="Flow_Appt_NoSlotEnd" sourceRef="Boundary_NoSlotLimit" targetRef="EndError_NoSlot" />
    <bpmn:sequenceFlow id="Flow_Appt_Yes" name="Yes" sourceRef="Gateway_SlotDisponible" targetRef="Task_CrearCita">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${slotAvailable}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Appt_04" sourceRef="Task_CrearCita" targetRef="Send_AppointmentCreated" />
    <bpmn:sequenceFlow id="Flow_Appt_05" sourceRef="Send_AppointmentCreated" targetRef="Gateway_AppointmentOutcome" />
    <bpmn:sequenceFlow id="Flow_Appt_08" sourceRef="Send_AppointmentCompleted" targetRef="End_AppointmentCompleted" />
    <bpmn:sequenceFlow id="Flow_Appt_07" sourceRef="Task_ActualizarStatus" targetRef="Send_AppointmentCompleted" />
    <bpmn:sequenceFlow id="Flow_Appt_06" sourceRef="Receive_ConsultationCompleted" targetRef="Task_ActualizarStatus" />
    <bpmn:sequenceFlow id="Flow_Appt_Outcome_Completed" sourceRef="Gateway_AppointmentOutcome" targetRef="Receive_ConsultationCompleted" />
    <bpmn:sequenceFlow id="Flow_Appt_Outcome_Cancelled" sourceRef="Gateway_AppointmentOutcome" targetRef="Receive_AppointmentCancelled" />
    <bpmn:sequenceFlow id="Flow_Appt_Outcome_Rescheduled" sourceRef="Gateway_AppointmentOutcome" targetRef="Receive_AppointmentRescheduled" />
    <bpmn:sequenceFlow id="Flow_Appt_Outcome_NoShow" sourceRef="Gateway_AppointmentOutcome" targetRef="Receive_AppointmentNoShow" />
    <bpmn:sequenceFlow id="Flow_Appt_Cancelled" sourceRef="Receive_AppointmentCancelled" targetRef="End_AppointmentCancelled" />
    <bpmn:sequenceFlow id="Flow_Appt_Rescheduled" sourceRef="Receive_AppointmentRescheduled" targetRef="End_AppointmentRescheduled" />
    <bpmn:sequenceFlow id="Flow_Appt_NoShow" sourceRef="Receive_AppointmentNoShow" targetRef="End_AppointmentNoShow" />
    <bpmn:sequenceFlow id="Flow_Appt_NoShowTimeout" sourceRef="Boundary_NoShowTimer" targetRef="End_AppointmentNoShow" />
    <bpmn:endEvent id="EndError_NoSlot" name="No slot available (timeout)">
      <bpmn:incoming>Flow_Appt_NoSlotEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Boundary_NoSlotLimit" name="No slot (5 min from request)">
      <bpmn:outgoing>Flow_Appt_NoSlotEnd</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1um24ua">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:startEvent id="Receive_PreConsultationSummaryGenerated" name="Receive PreConsultationSummaryGenerated">
      <bpmn:outgoing>Flow_Appt_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_PreSummary_Appt" messageRef="Message_PreConsultationSummaryGenerated" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="Process_Consultation" name="medical-consultation" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:startEvent id="Receive_StartMedicalConsultation" name="Receive StartMedicalConsultation">
      <bpmn:outgoing>Flow_Cons_01</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_StartMedicalConsultation" messageRef="Message_StartMedicalConsultation" />
    </bpmn:startEvent>
    <bpmn:intermediateCatchEvent id="Boundary_StartNoShow" name="Not started (15 min from start)">
      <bpmn:outgoing>Flow_Cons_NotStarted</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_1n4vkrx">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT15M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_Consultation" name="Consultation finalized">
      <bpmn:incoming>Flow_Cons_07</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Send_PostConsultationSummaryGenerated" name="Emit PostConsultationSummaryGenerated" camunda:type="external" camunda:topic="consultation.emit-post-summary">
      <bpmn:incoming>Flow_Cons_06</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_07</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_GenerarPostSummary" name="Generate PostConsultationSummary" camunda:type="external" camunda:topic="consultation.generate-post-summary">
      <bpmn:incoming>Flow_Cons_05</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Send_ConsultationCompleted" name="Emit ConsultationCompleted" camunda:type="external" camunda:topic="consultation.emit-completed">
      <bpmn:incoming>Flow_Cons_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_05</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:sequenceFlow id="Flow_Cons_01" sourceRef="Receive_StartMedicalConsultation" targetRef="Receive_PreConsultationSummary_Consultation" />
    <bpmn:sequenceFlow id="Flow_Cons_PreSummary" sourceRef="Receive_PreConsultationSummary_Consultation" targetRef="Task_RegistrarDatos" />
    <bpmn:sequenceFlow id="Flow_Cons_02" sourceRef="Task_RegistrarDatos" targetRef="Gateway_Remision" />
    <bpmn:sequenceFlow id="Flow_Cons_Yes" name="Yes" sourceRef="Gateway_Remision" targetRef="Task_RegistrarRemision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requiresReferral}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cons_No" name="No" sourceRef="Gateway_Remision" targetRef="Task_FinalizarConsulta">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!requiresReferral}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cons_03" sourceRef="Task_RegistrarRemision" targetRef="Send_ReferralCreated" />
    <bpmn:sequenceFlow id="Flow_Cons_03b" sourceRef="Send_ReferralCreated" targetRef="Task_FinalizarConsulta" />
    <bpmn:sequenceFlow id="Flow_Cons_04" sourceRef="Task_FinalizarConsulta" targetRef="Send_ConsultationCompleted" />
    <bpmn:sequenceFlow id="Flow_Cons_NotStarted" sourceRef="Boundary_StartNoShow" targetRef="End_ConsultationNotStarted" />
    <bpmn:sequenceFlow id="Flow_Cons_07" sourceRef="Send_PostConsultationSummaryGenerated" targetRef="End_Consultation" />
    <bpmn:sequenceFlow id="Flow_Cons_06" sourceRef="Task_GenerarPostSummary" targetRef="Send_PostConsultationSummaryGenerated" />
    <bpmn:sequenceFlow id="Flow_Cons_05" sourceRef="Send_ConsultationCompleted" targetRef="Task_GenerarPostSummary" />
    <bpmn:userTask id="Task_RegistrarRemision" name="Record referral" camunda:candidateGroups="medical-staff">
      <bpmn:incoming>Flow_Cons_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Send_ReferralCreated" name="Emit ReferralCreated" camunda:type="external" camunda:topic="consultation.emit-referral">
      <bpmn:incoming>Flow_Cons_03</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_03b</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_FinalizarConsulta" name="Finalize consultation" camunda:candidateGroups="medical-staff">
      <bpmn:incoming>Flow_Cons_No</bpmn:incoming>
      <bpmn:incoming>Flow_Cons_03b</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_04</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Remision" name="Referral?">
      <bpmn:incoming>Flow_Cons_02</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cons_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_RegistrarDatos" name="Record clinical data" camunda:candidateGroups="medical-staff">
      <bpmn:incoming>Flow_Cons_PreSummary</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Receive_PreConsultationSummary_Consultation" name="Receive PreConsultationSummaryGenerated">
      <bpmn:incoming>Flow_Cons_01</bpmn:incoming>
      <bpmn:outgoing>Flow_Cons_PreSummary</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MsgDef_PreSummary_Cons" messageRef="Message_PreConsultationSummaryGenerated" />
    </bpmn:intermediateCatchEvent>
    <bpmn:endEvent id="End_ConsultationNotStarted" name="Consultation not started">
      <bpmn:incoming>Flow_Cons_NotStarted</bpmn:incoming>
    </bpmn:endEvent>
  </bpmn:process>
  <bpmn:process id="Process_Document" name="document-generation" isExecutable="true" camunda:historyTimeToLive="180">
    <bpmn:sequenceFlow id="Flow_Doc_01" sourceRef="Receive_PostConsultationSummaryGenerated" targetRef="Task_CrearPENDING" />
    <bpmn:sequenceFlow id="Flow_Doc_02" sourceRef="Task_CrearPENDING" targetRef="Task_GenerarPDF" />
    <bpmn:sequenceFlow id="Flow_Doc_RetryLoop" name="&#60; 3" sourceRef="Gateway_RetryLimit" targetRef="Task_GenerarPDF">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${retry_count &lt; 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Doc_03" sourceRef="Task_GenerarPDF" targetRef="Gateway_PDFOK" />
    <bpmn:sequenceFlow id="Flow_Doc_Yes" name="Yes" sourceRef="Gateway_PDFOK" targetRef="Task_GuardarBinario">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${pdfGenerated}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Doc_No" name="No" sourceRef="Gateway_PDFOK" targetRef="Task_MarcarERROR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${!pdfGenerated}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Doc_04" sourceRef="Task_GuardarBinario" targetRef="Task_ActualizarAVAILABLE" />
    <bpmn:sequenceFlow id="Flow_Doc_05" sourceRef="Task_ActualizarAVAILABLE" targetRef="Send_ConsultationPdfGenerated" />
    <bpmn:sequenceFlow id="Flow_Doc_06" sourceRef="Send_ConsultationPdfGenerated" targetRef="End_DocumentGenerated" />
    <bpmn:sequenceFlow id="Flow_Doc_Timeout" sourceRef="Boundary_PDFTimeout" targetRef="Task_MarcarERROR" />
    <bpmn:sequenceFlow id="Flow_Doc_Error" sourceRef="Boundary_PDFError" targetRef="Task_MarcarERROR" />
    <bpmn:sequenceFlow id="Flow_Doc_07" sourceRef="Task_MarcarERROR" targetRef="Gateway_RetryLimit" />
    <bpmn:sequenceFlow id="Flow_Doc_ManualRetry" sourceRef="Receive_ManualRetry" targetRef="Gateway_RetryLimit" />
    <bpmn:sequenceFlow id="Flow_Doc_MaxRetries" name="&#62;= 3" sourceRef="Gateway_RetryLimit" targetRef="EndError_PDF">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${retry_count &gt;= 3}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="End_DocumentGenerated" name="Document generated">
      <bpmn:incoming>Flow_Doc_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sendTask id="Send_ConsultationPdfGenerated" name="Emit ConsultationPdfGenerated" camunda:type="external" camunda:topic="doc.emit-pdf-generated">
      <bpmn:incoming>Flow_Doc_05</bpmn:incoming>
      <bpmn:outgoing>Flow_Doc_06</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_ActualizarAVAILABLE" name="Status = AVAILABLE" camunda:type="external" camunda:topic="doc.update-available">
      <bpmn:incoming>Flow_Doc_04</bpmn:incoming>
      <bpmn:outgoing>Flow_Doc_05</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndError_PDF" name="Document ERROR">
      <bpmn:incoming>Flow_Doc_MaxRetries</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_MarcarERROR" name="Mark ERROR" camunda:type="external" camunda:topic="doc.mark-error">
      <bpmn:incoming>Flow_Doc_No</bpmn:incoming>
      <bpmn:incoming>Flow_Doc_Timeout</bpmn:incoming>
      <bpmn:incoming>Flow_Doc_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_Doc_07</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_RetryLimit" name="retry_count &#60; 3?">
      <bpmn:incoming>Flow_Doc_07</bpmn:incoming>
      <bpmn:incoming>Flow_Doc_ManualRetry</bpmn:incoming>
      <bpmn:outgoing>Flow_Doc_RetryLoop</bpmn:outgoing>
      <bpmn:outgoing>Flow_Doc_MaxRetries</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GuardarBinario" name="Save binary to storage" camunda:type="external" camunda:topic="doc.save-binary">
      <bpmn:incoming>Flow_Doc_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Doc_04</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PDFOK" name="PDF OK?">
      <bpmn:incoming>Flow_Doc_03</bpmn:incoming>
      <bpmn:outgoing>Flow_Doc_Yes</bpmn:outgoing>
      <bpmn:outgoing>Flow_Doc_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GenerarPDF" name="Generate PDF (retry_count++)" camunda:type="external" camunda:topic="doc.generate-pdf">
      <bpmn:incoming>Flow_Doc_02</bpmn:incoming>
      <bpmn:incoming>Flow_Doc_RetryLoop</bpmn:incoming>
